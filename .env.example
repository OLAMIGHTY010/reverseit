# ==============================================================================
# SMARTREVERSAL PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================
# Enterprise Financial Operations & Controlled Reversal Platform
# Copy this file to .env for local development: cp .env.example .env
# NOTE: Never commit sensitive keys, production secrets, or tokens to VCS.
# ==============================================================================

# ------------------------------------------------------------------------------
# Global System Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=debug
APP_NAME=smartreversal
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=smartreversal_app
DB_PASSWORD=development_secret_only
DB_NAME=smartreversal_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# ------------------------------------------------------------------------------
# Cache & Message Broker (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# Core Backend Service (apps/api - Go + Chi)
# ------------------------------------------------------------------------------
API_PORT=8080
API_READ_TIMEOUT=15s
API_WRITE_TIMEOUT=15s
API_IDLE_TIMEOUT=60s
API_SHUTDOWN_TIMEOUT=20s

# Worker process (apps/api/cmd/worker)
WORKER_HEALTH_PORT=8081
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
# Ed25519 signing key for the process that issues tokens (the API). Generate
# one with: cd apps/api && go run ./cmd/keygen
# Never commit a real key. Other processes verify with public keys only.
JWT_KEY_ID=k1
JWT_PRIVATE_KEY=
# Extra verification keys, "kid:base64,kid:base64". The public half of
# JWT_PRIVATE_KEY is added automatically.
JWT_PUBLIC_KEYS=
JWT_TOKEN_TTL=15m

# Account tokens and the sealed account vault: two random 32-byte keys, base64.
# Generated by the same keygen command. Losing ACCOUNT_ENC_KEY makes sealed
# accounts unreadable; changing ACCOUNT_TOKEN_KEY changes every token.
ACCOUNT_TOKEN_KEY=
ACCOUNT_ENC_KEY=
ACCOUNT_ENC_KEY_ID=k1

# Gate for any call to a reversal provider. Keep false. Production refuses true.
FINANCIAL_EXECUTION_ENABLED=false
# Development sign-in for synthetic ReverseIt customers. Refused when ENVIRONMENT=production.
CUSTOMER_DEV_LOGIN_ENABLED=false

# ------------------------------------------------------------------------------
# AI & Investigation Intelligence Service (apps/ai-service - Python + FastAPI)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_MODEL_CONFIDENCE_THRESHOLD=0.85
AI_ANOMALY_DETECTION_WINDOW_HOURS=24

# ------------------------------------------------------------------------------
# Web Frontend Console (apps/web - Vite + React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_AI_SERVICE_URL=http://localhost:8000/api/v1
VITE_ENABLE_ANALYTICS=false

# ------------------------------------------------------------------------------
# Financial Integration Adapters (Stubs / Sandbox)
# ------------------------------------------------------------------------------
NIP_SWITCH_MOCK_ENABLED=true
POS_ACQUIRER_MOCK_ENABLED=true
CARD_SCHEME_MOCK_ENABLED=true
SETTLEMENT_FILE_STORAGE_PATH=./infra/docker/data/settlements
